#!/bin/bash
#PBS -N DRAGEN_GenomicsDB
#PBS -l walltime=96:00:00
#PBS -l select=1:ncpus=16:mem=64gb
#PBS -j oe

set -euo pipefail

echo "============================================================"
echo "DRAGEN-GATK GenomicsDBImport"
echo "============================================================"
date
echo "Host: $(hostname)"
echo "PBS job ID: ${PBS_JOBID:-unknown}"
echo

module purge
module load app/gatk/4.6.2.0

BASE_DIR="${HOME}/Variantcalling/dragen_gatk"
REFERENCE="${HOME}/Variantcalling/reference/hg38.fa"
INTERVALS="${BASE_DIR}/../gatk/hg38.gatk.intervals"

COHORT_DIR="/stor6/scratch3/27777197/dragen_gatk_cohort"
GENOMICSDB="${COHORT_DIR}/genomicsdb"
SAMPLE_MAP="${COHORT_DIR}/sample_map.txt"
DONE="${COHORT_DIR}/GenomicsDBImport.done"

TMP_DIR="${HOME}/Variantcalling/dragen_gatk_cohort_tmp"

mkdir -p "${COHORT_DIR}"
mkdir -p "${TMP_DIR}"

# ------------------------------------------------------------------
# Input samples
# ------------------------------------------------------------------

SAMPLES=(
1001 1003 1004 1005 1007 1008 1009 1010 1011 1013 1014 1015
1017 1018 1019 1020 1021 1022 1023 1024 1025 1026 1027 1029
1032 1033 1035 1036 1037 1038 1041 1042 1054 1060 1064 1747
1756 35 47 549 73 792 899 906
)

echo "Expected samples: ${#SAMPLES[@]}"
echo

# ------------------------------------------------------------------
# Reuse protection
# ------------------------------------------------------------------

if [[ -f "${DONE}" ]]; then
    echo "GenomicsDBImport already marked COMPLETE."
    echo "Marker: ${DONE}"
    echo
    echo "Nothing to do."
    exit 0
fi

if [[ -d "${GENOMICSDB}" ]] && find "${GENOMICSDB}" -mindepth 1 -print -quit | grep -q .; then
    echo "ERROR: GenomicsDB workspace already exists and is not empty:"
    echo "       ${GENOMICSDB}"
    echo
    echo "No overwrite will be performed."
    echo "Inspect the workspace before submitting this job."
    exit 1
fi

# ------------------------------------------------------------------
# Check reference and intervals
# ------------------------------------------------------------------

[[ -f "${REFERENCE}" ]] || {
    echo "ERROR: Reference not found: ${REFERENCE}"
    exit 1
}

[[ -f "${REFERENCE}.fai" ]] || {
    echo "ERROR: Reference index not found: ${REFERENCE}.fai"
    exit 1
}

[[ -f "${HOME}/Variantcalling/reference/hg38.dict" ]] || {
    echo "ERROR: Reference dictionary not found:"
    echo "       ${HOME}/Variantcalling/reference/hg38.dict"
    exit 1
}

[[ -f "${INTERVALS}" ]] || {
    echo "ERROR: GATK intervals file not found: ${INTERVALS}"
    exit 1
}

# ------------------------------------------------------------------
# Build and validate sample map
# ------------------------------------------------------------------

: > "${SAMPLE_MAP}"

for SAMPLE in "${SAMPLES[@]}"; do
    GVCF="${BASE_DIR}/${SAMPLE}/haplotypecaller/${SAMPLE}.g.vcf.gz"
    INDEX="${GVCF}.tbi"

    if [[ ! -s "${GVCF}" ]]; then
        echo "ERROR: Missing or empty gVCF:"
        echo "       ${GVCF}"
        exit 1
    fi

    if [[ ! -s "${INDEX}" ]]; then
        echo "ERROR: Missing or empty gVCF index:"
        echo "       ${INDEX}"
        exit 1
    fi

    printf "%s\t%s\n" "${SAMPLE}" "${GVCF}" >> "${SAMPLE_MAP}"
done

ACTUAL_SAMPLES=$(wc -l < "${SAMPLE_MAP}")

echo "Validated gVCFs: ${ACTUAL_SAMPLES}"
echo

if [[ "${ACTUAL_SAMPLES}" -ne 44 ]]; then
    echo "ERROR: Expected 44 gVCFs, found ${ACTUAL_SAMPLES}."
    echo "Wait until all 44 DRAGEN-GATK sample gVCFs are complete."
    exit 1
fi

echo "Sample map:"
cat "${SAMPLE_MAP}"
echo

# ------------------------------------------------------------------
# GenomicsDBImport
# ------------------------------------------------------------------

echo "============================================================"
echo "Starting GenomicsDBImport"
echo "============================================================"
date

gatk --java-options "-Xmx56g" GenomicsDBImport \
    --genomicsdb-workspace-path "${GENOMICSDB}" \
    --sample-name-map "${SAMPLE_MAP}" \
    -L "${INTERVALS}" \
    --tmp-dir "${TMP_DIR}" \
    --batch-size 8

echo
echo "============================================================"
echo "GenomicsDBImport completed successfully"
echo "============================================================"
date

# ------------------------------------------------------------------
# Completion marker
# ------------------------------------------------------------------

{
    echo "DRAGEN-GATK GenomicsDBImport completed successfully."
    echo "Samples imported: ${ACTUAL_SAMPLES}"
    echo "GenomicsDB: ${GENOMICSDB}"
    echo "Completed: $(date)"
} > "${DONE}"

echo
echo "Completion marker:"
cat "${DONE}"

echo
echo "GenomicsDB workspace:"
ls -ld "${GENOMICSDB}"

echo
echo "DONE"
