#!/bin/bash
#PBS -N GATK_HARD_FILTER
#PBS -l walltime=48:00:00
#PBS -l select=1:ncpus=4:mem=32gb
#PBS -j oe

set -euo pipefail

module purge
module load app/gatk/4.4.0.0
module load app/bcftools/1.19

INPUT="/stor6/scratch3/27777197/gatk_cohort/output/gatk_final.vcf.gz"
OUTDIR="/stor6/scratch3/27777197/gatk_cohort/filtering"

SNP_RAW="${OUTDIR}/gatk_snps.vcf.gz"
INDEL_RAW="${OUTDIR}/gatk_indels.vcf.gz"

SNP_FILTERED="${OUTDIR}/gatk_snps_hardfiltered.vcf.gz"
INDEL_FILTERED="${OUTDIR}/gatk_indels_hardfiltered.vcf.gz"

SNP_PASS="${OUTDIR}/gatk_snps_PASS.vcf.gz"
INDEL_PASS="${OUTDIR}/gatk_indels_PASS.vcf.gz"

FINAL="${OUTDIR}/gatk_hardfiltered_PASS.vcf.gz"

DONE="${OUTDIR}/GATK_HARD_FILTER.done"

echo "=========================================="
echo "GATK HARD FILTERING"
echo "Host: $(hostname)"
echo "Start: $(date)"
echo "Input: ${INPUT}"
echo "Output directory: ${OUTDIR}"
echo "=========================================="

test -s "${INPUT}"
test -s "${INPUT}.tbi" || test -s "${INPUT}.csi"

mkdir -p "${OUTDIR}"

if [[ -e "${DONE}" ]]; then
    echo "DONE marker already exists."
    exit 0
fi

echo
echo "=========================================="
echo "STEP 1: Separate SNPs and INDELs"
echo "=========================================="

gatk SelectVariants \
    -R "${HOME}/Variantcalling/reference/hg38.fa" \
    -V "${INPUT}" \
    --select-type-to-include SNP \
    -O "${SNP_RAW}"

gatk SelectVariants \
    -R "${HOME}/Variantcalling/reference/hg38.fa" \
    -V "${INPUT}" \
    --select-type-to-include INDEL \
    -O "${INDEL_RAW}"

echo
echo "SNPs:"
bcftools index -n "${SNP_RAW}"

echo "INDELs:"
bcftools index -n "${INDEL_RAW}"

echo
echo "=========================================="
echo "STEP 2: Hard-filter SNPs"
echo "=========================================="

gatk VariantFiltration \
    -R "${HOME}/Variantcalling/reference/hg38.fa" \
    -V "${SNP_RAW}" \
    --filter-name "QD_lt_2" \
    --filter-expression "QD < 2.0" \
    --filter-name "FS_gt_60" \
    --filter-expression "FS > 60.0" \
    --filter-name "SOR_gt_3" \
    --filter-expression "SOR > 3.0" \
    --filter-name "MQ_lt_40" \
    --filter-expression "MQ < 40.0" \
    --filter-name "MQRankSum_lt_-12.5" \
    --filter-expression "MQRankSum < -12.5" \
    --filter-name "ReadPosRankSum_lt_-8" \
    --filter-expression "ReadPosRankSum < -8.0" \
    -O "${SNP_FILTERED}"

echo
echo "=========================================="
echo "STEP 3: Hard-filter INDELs"
echo "=========================================="

gatk VariantFiltration \
    -R "${HOME}/Variantcalling/reference/hg38.fa" \
    -V "${INDEL_RAW}" \
    --filter-name "QD_lt_2" \
    --filter-expression "QD < 2.0" \
    --filter-name "FS_gt_200" \
    --filter-expression "FS > 200.0" \
    --filter-name "SOR_gt_10" \
    --filter-expression "SOR > 10.0" \
    --filter-name "ReadPosRankSum_lt_-20" \
    --filter-expression "ReadPosRankSum < -20.0" \
    -O "${INDEL_FILTERED}"

echo
echo "=========================================="
echo "STEP 4: Keep PASS variants"
echo "=========================================="

bcftools view \
    -f PASS \
    -Oz \
    -o "${SNP_PASS}" \
    "${SNP_FILTERED}"

bcftools view \
    -f PASS \
    -Oz \
    -o "${INDEL_PASS}" \
    "${INDEL_FILTERED}"

bcftools index -t "${SNP_PASS}"
bcftools index -t "${INDEL_PASS}"

echo
echo "=========================================="
echo "STEP 5: Combine PASS SNPs + INDELs"
echo "=========================================="

bcftools concat \
    -a \
    -Oz \
    -o "${FINAL}" \
    "${SNP_PASS}" \
    "${INDEL_PASS}"

bcftools index -t "${FINAL}"

echo
echo "=========================================="
echo "STEP 6: Basic validation"
echo "=========================================="

echo "Final PASS variant count:"
bcftools index -n "${FINAL}"

echo
echo "Final VCF:"
ls -lh "${FINAL}" "${FINAL}.tbi"

echo
echo "Checking VCF readability..."
bcftools view -h "${FINAL}" >/dev/null

echo
echo "Checking sample count..."
bcftools query -l "${FINAL}" | wc -l

echo
echo "Creating completion marker..."
touch "${DONE}"

echo
echo "=========================================="
echo "HARD FILTERING COMPLETE"
echo "Finished: $(date)"
echo "Final VCF: ${FINAL}"
echo "=========================================="