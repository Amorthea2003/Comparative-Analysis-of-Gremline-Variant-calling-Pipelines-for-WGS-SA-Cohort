#!/bin/bash

#PBS -N GATK_preprocess
#PBS -l walltime=96:00:00
#PBS -l select=1:ncpus=24:mem=64gb
#PBS -e gatk_preprocess.err
#PBS -o gatk_preprocess.out
#PBS -M 27777197@sun.ac.za
#PBS -m abe

set -euo pipefail



# CHECK SAMPLE


if [[ -z "${SAMPLE:-}" ]]; then
    echo "ERROR: SAMPLE was not specified."
    echo "Usage: qsub -v SAMPLE=1001 gatk_preprocessing.pbs"
    exit 1
fi



# DIRECTORIES


BASE_DIR="${HOME}/Variantcalling"

REF_DIR="${BASE_DIR}/reference"
SAMPLE_DIR="${HOME}/fastQ_files/${SAMPLE}"
OUT_DIR="${BASE_DIR}/gatk/${SAMPLE}"

REFERENCE="${REF_DIR}/hg38.fa"
BWA_INDEX="${REF_DIR}/hg38idx"



# CREATE OUTPUT DIRECTORY


mkdir -p "${OUT_DIR}"



# LOGGING


LOG_FILE="${OUT_DIR}/preprocessing.log"

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" | tee -a "${LOG_FILE}"
}


log "============================================================"
log "Starting GATK preprocessing for sample ${SAMPLE}"
log "============================================================"



# CHECK REFERENCE FILES


log "Checking reference genome..."

if [[ ! -f "${REFERENCE}" ]]; then
    log "ERROR: Reference genome not found: ${REFERENCE}"
    exit 1
fi

if [[ ! -f "${REFERENCE}.fai" ]]; then
    log "ERROR: FASTA index not found: ${REFERENCE}.fai"
    exit 1
fi

if [[ ! -f "${REF_DIR}/hg38.dict" ]]; then
    log "ERROR: Sequence dictionary not found: ${REF_DIR}/hg38.dict"
    exit 1
fi

if [[ ! -f "${BWA_INDEX}.bwt" ]]; then
    log "ERROR: BWA index not found: ${BWA_INDEX}.bwt"
    exit 1
fi

if [[ ! -f "${BWA_INDEX}.ann" ]]; then
    log "ERROR: BWA index .ann file not found: ${BWA_INDEX}.ann"
    exit 1
fi

if [[ ! -f "${BWA_INDEX}.amb" ]]; then
    log "ERROR: BWA index .amb file not found: ${BWA_INDEX}.amb"
    exit 1
fi

if [[ ! -f "${BWA_INDEX}.pac" ]]; then
    log "ERROR: BWA index .pac file not found: ${BWA_INDEX}.pac"
    exit 1
fi

if [[ ! -f "${BWA_INDEX}.sa" ]]; then
    log "ERROR: BWA index .sa file not found: ${BWA_INDEX}.sa"
    exit 1
fi

log "Reference genome and indexes found."



# CHECK SAMPLE DIRECTORY


log "Checking sample directory..."

if [[ ! -d "${SAMPLE_DIR}" ]]; then
    log "ERROR: Sample directory not found: ${SAMPLE_DIR}"
    exit 1
fi

log "Sample directory: ${SAMPLE_DIR}"



# IDENTIFY FASTQ FILES


log "Searching for FASTQ files..."

shopt -s nullglob

R1_FILES=("${SAMPLE_DIR}"/*_1.fq.gz)
R2_FILES=("${SAMPLE_DIR}"/*_2.fq.gz)

shopt -u nullglob


if [[ ${#R1_FILES[@]} -eq 0 ]]; then
    log "ERROR: No R1 FASTQ files found in ${SAMPLE_DIR}"
    exit 1
fi

if [[ ${#R2_FILES[@]} -eq 0 ]]; then
    log "ERROR: No R2 FASTQ files found in ${SAMPLE_DIR}"
    exit 1
fi


log "R1 FASTQ files found:"
printf '%s\n' "${R1_FILES[@]}" | tee -a "${LOG_FILE}"

log "R2 FASTQ files found:"
printf '%s\n' "${R2_FILES[@]}" | tee -a "${LOG_FILE}"



# FASTQC


log "Starting FastQC..."

module purge
module load app/fastqc/0.12.1

mkdir -p "${OUT_DIR}/FastQC"

fastqc \
    "${R1_FILES[@]}" \
    "${R2_FILES[@]}" \
    -o "${OUT_DIR}/FastQC" \
    --noextract

log "Finished FastQC."



# MULTIQC


log "Starting MultiQC..."

module purge
module load app/multiqc/1.21

multiqc \
    "${OUT_DIR}/FastQC" \
    -o "${OUT_DIR}/FastQC"

log "Finished MultiQC."



# BWA-MEM ALIGNMENT


log "Starting BWA-MEM alignment..."

module purge
module load app/bwa/0.7.17

SAM_FILE="${OUT_DIR}/${SAMPLE}.sam"

bwa mem \
    -M \
    -t 24 \
    -R "@RG\tID:${SAMPLE}\tLB:lib1\tPL:MGI\tPU:unit1\tSM:${SAMPLE}" \
    "${BWA_INDEX}" \
    "${R1_FILES[@]}" \
    "${R2_FILES[@]}" \
    > "${SAM_FILE}"

log "Finished BWA-MEM alignment."



# SAM TO BAM


log "Starting SAM to BAM conversion..."

module purge
module load app/samtools/1.20

BAM_FILE="${OUT_DIR}/${SAMPLE}.bam"

samtools view \
    -@ 24 \
    -b \
    "${SAM_FILE}" \
    -o "${BAM_FILE}"

log "Finished SAM to BAM conversion."



# SORT BAM


log "Starting BAM sorting..."

SORTED_BAM="${OUT_DIR}/${SAMPLE}_sorted.bam"

samtools sort \
    -@ 24 \
    -o "${SORTED_BAM}" \
    -T "${OUT_DIR}/${SAMPLE}_sort_temp" \
    "${BAM_FILE}"

log "Finished BAM sorting."



# REMOVE INTERMEDIATE SAM/BAM


log "Removing intermediate SAM/BAM files..."

rm -f "${SAM_FILE}"
rm -f "${BAM_FILE}"

log "Intermediate files removed."



# MARK DUPLICATES


log "Starting MarkDuplicates..."

module purge
module load app/gatk/4.4.0.0

DEDUP_BAM="${OUT_DIR}/${SAMPLE}_dedup.bam"
DUP_METRICS="${OUT_DIR}/${SAMPLE}_duplicate_metrics.txt"

gatk MarkDuplicates \
    -I "${SORTED_BAM}" \
    -O "${DEDUP_BAM}" \
    -M "${DUP_METRICS}" \
    --CREATE_INDEX true

log "Finished MarkDuplicates."



# REMOVE SORTED BAM


log "Removing intermediate sorted BAM..."

rm -f "${SORTED_BAM}"

log "Intermediate sorted BAM removed."



# VALIDATE BAM


log "Starting ValidateSamFile..."

gatk ValidateSamFile \
    -I "${DEDUP_BAM}" \
    -M SUMMARY \
    > "${OUT_DIR}/${SAMPLE}_ValidateSamFile.txt"

log "Finished ValidateSamFile."



# FINAL CHECKS


log "Performing final checks..."

if [[ ! -f "${DEDUP_BAM}" ]]; then
    log "ERROR: Deduplicated BAM was not created."
    exit 1
fi

if [[ ! -f "${DEDUP_BAM}.bai" ]]; then
    log "ERROR: BAM index was not created."
    exit 1
fi

if [[ ! -f "${DUP_METRICS}" ]]; then
    log "ERROR: Duplicate metrics file was not created."
    exit 1
fi



# COMPLETED


log "============================================================"
log "GATK preprocessing completed successfully for ${SAMPLE}"
log "============================================================"
log "Deduplicated BAM: ${DEDUP_BAM}"
log "BAM index: ${DEDUP_BAM}.bai"
log "Duplicate metrics: ${DUP_METRICS}"
log "============================================================"