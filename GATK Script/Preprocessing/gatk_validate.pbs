#!/bin/bash

#PBS -N GATK_Validate
#PBS -l walltime=12:00:00
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -M 27777197@sun.ac.za
#PBS -m abe

set -euo pipefail


# CHECK SAMPLE


if [[ -z "${SAMPLE:-}" ]]; then
    echo "ERROR: SAMPLE was not specified."
    echo "Usage: qsub -v SAMPLE=<sample_id> gatk_validate.pbs"
    exit 1
fi


# DIRECTORIES


BASE_DIR="${HOME}/Variantcalling"
OUT_DIR="${BASE_DIR}/gatk/${SAMPLE}"

# Corrected BAM produced by FixRG
FIXED_BAM="${OUT_DIR}/${SAMPLE}_dedup_fixed.bam"
FIXED_BAI="${OUT_DIR}/${SAMPLE}_dedup_fixed.bam.bai"

VALIDATION_FILE="${OUT_DIR}/${SAMPLE}_ValidateSamFile.txt"
LOG_FILE="${OUT_DIR}/validate.log"

mkdir -p "${OUT_DIR}"


# LOGGING


log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" | tee -a "${LOG_FILE}"
}

log "============================================================"
log "Starting GATK ValidateSamFile for sample ${SAMPLE}"
log "============================================================"

log "Node: $(hostname)"
log "Job ID: ${PBS_JOBID:-unknown}"


# CHECK INPUT BAM


log "Checking corrected deduplicated BAM..."

if [[ ! -s "${FIXED_BAM}" ]]; then
    log "ERROR: Corrected BAM not found or empty:"
    log "${FIXED_BAM}"
    exit 1
fi

log "Corrected BAM found:"
ls -lh "${FIXED_BAM}" | tee -a "${LOG_FILE}"


# CHECK BAM INDEX


log "Checking corrected BAM index..."

if [[ ! -s "${FIXED_BAI}" ]]; then
    log "ERROR: Corrected BAM index not found or empty:"
    log "${FIXED_BAI}"
    exit 1
fi

log "Corrected BAM index found:"
ls -lh "${FIXED_BAI}" | tee -a "${LOG_FILE}"


# LOAD GATK


log "Loading GATK..."

module purge
module load app/gatk/4.4.0.0

log "GATK version:"
gatk --version 2>&1 | tee -a "${LOG_FILE}"


# RUN VALIDATESAMFILE


log "Starting ValidateSamFile..."

gatk ValidateSamFile \
    -I "${FIXED_BAM}" \
    -M SUMMARY \
    > "${VALIDATION_FILE}" \
    2>> "${LOG_FILE}"

log "ValidateSamFile completed."


# CHECK OUTPUT


if [[ ! -s "${VALIDATION_FILE}" ]]; then
    log "ERROR: ValidateSamFile output was not created or is empty."
    exit 1
fi

log "Validation output:"
ls -lh "${VALIDATION_FILE}" | tee -a "${LOG_FILE}"


# SHOW SUMMARY


log "Validation summary:"
cat "${VALIDATION_FILE}" | tee -a "${LOG_FILE}"


# COMPLETED


log "============================================================"
log "GATK ValidateSamFile completed successfully"
log "Sample: ${SAMPLE}"
log "Validation file: ${VALIDATION_FILE}"
log "============================================================"