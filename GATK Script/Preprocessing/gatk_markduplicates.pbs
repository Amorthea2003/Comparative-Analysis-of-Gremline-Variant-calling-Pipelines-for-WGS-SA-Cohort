#!/bin/bash

#PBS -N GATK_MarkDup
#PBS -l walltime=96:00:00
#PBS -l select=1:ncpus=24:mem=64gb
#PBS -M 27777197@sun.ac.za
#PBS -m abe

set -euo pipefail


# CHECK SAMPLE


if [[ -z "${SAMPLE:-}" ]]; then
    echo "ERROR: SAMPLE was not specified."
    echo "Usage: qsub -v SAMPLE=47 gatk_markduplicates.pbs"
    exit 1
fi



# DIRECTORIES


BASE_DIR="${HOME}/Variantcalling"
OUT_DIR="${BASE_DIR}/gatk/${SAMPLE}"

SORTED_BAM="${OUT_DIR}/${SAMPLE}_sorted.bam"
DEDUP_BAM="${OUT_DIR}/${SAMPLE}_dedup.bam"
DUP_METRICS="${OUT_DIR}/${SAMPLE}_duplicate_metrics.txt"
VALIDATION="${OUT_DIR}/${SAMPLE}_ValidateSamFile.txt"

mkdir -p "${OUT_DIR}"

LOG_FILE="${OUT_DIR}/markduplicates.log"



# LOGGING


log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" | tee -a "${LOG_FILE}"
}


log "============================================================"
log "Starting GATK MarkDuplicates for sample ${SAMPLE}"
log "============================================================"

log "Node: $(hostname)"
log "Job ID: ${PBS_JOBID:-unknown}"



# CHECK INPUT BAM


log "Checking sorted BAM..."

if [[ ! -s "${SORTED_BAM}" ]]; then
    log "ERROR: Sorted BAM does not exist or is empty:"
    log "${SORTED_BAM}"
    exit 1
fi

if [[ ! -s "${SORTED_BAM}.bai" ]]; then
    log "ERROR: Sorted BAM index does not exist:"
    log "${SORTED_BAM}.bai"
    exit 1
fi

log "Sorted BAM found:"
ls -lh "${SORTED_BAM}" | tee -a "${LOG_FILE}"

log "Sorted BAM index found:"
ls -lh "${SORTED_BAM}.bai" | tee -a "${LOG_FILE}"



# CHECK IF MARKDUPLICATES ALREADY COMPLETED


if [[ -s "${DEDUP_BAM}" && -s "${DUP_METRICS}" ]]; then

    log "Deduplicated BAM and duplicate metrics already exist."
    log "Skipping MarkDuplicates."

    log "Deduplicated BAM:"
    ls -lh "${DEDUP_BAM}" | tee -a "${LOG_FILE}"

    log "Duplicate metrics:"
    ls -lh "${DUP_METRICS}" | tee -a "${LOG_FILE}"

    exit 0
fi



# REMOVE INCOMPLETE OUTPUTS


if [[ -f "${DEDUP_BAM}" && ! -s "${DEDUP_BAM}" ]]; then
    log "Removing empty deduplicated BAM."
    rm -f "${DEDUP_BAM}"
fi

if [[ -f "${DUP_METRICS}" && ! -s "${DUP_METRICS}" ]]; then
    log "Removing empty duplicate metrics file."
    rm -f "${DUP_METRICS}"
fi



# FIND SUITABLE TEMPORARY STORAGE


log "Searching for temporary storage with enough free space..."

CANDIDATE_DIRS=(
    "/var/tmp"
    "/tmp"
    "${TMPDIR:-}"
)

TMP_BASE=""

for DIR in "${CANDIDATE_DIRS[@]}"; do

    if [[ -z "${DIR}" ]]; then
        continue
    fi

    if [[ ! -d "${DIR}" ]]; then
        continue
    fi

    AVAILABLE_GB=$(df -Pk "${DIR}" | awk 'NR==2 {print int($4/1024/1024)}')

    log "Temporary location: ${DIR}"
    log "Available space: ${AVAILABLE_GB} GB"

    if (( AVAILABLE_GB >= 40 )); then
        TMP_BASE="${DIR}"
        break
    fi

done

if [[ -z "${TMP_BASE}" ]]; then

    log "ERROR: No temporary filesystem has at least 40 GB available."
    log "MarkDuplicates will NOT be started."
    log "Resubmit the job so that it can run on another node."

    exit 1

fi

TMP_DIR="${TMP_BASE}/gatk_${SAMPLE}_${PBS_JOBID}"

mkdir -p "${TMP_DIR}"

log "Using temporary directory:"
log "${TMP_DIR}"

df -h "${TMP_DIR}" | tee -a "${LOG_FILE}"



# LOAD GATK


module purge
module load app/gatk/4.4.0.0


log "GATK version:"
gatk --version | tee -a "${LOG_FILE}"



# DISK SPACE CHECK


log "Checking home filesystem space..."

df -h "${OUT_DIR}" | tee -a "${LOG_FILE}"



# MARK DUPLICATES


log "============================================================"
log "Starting MarkDuplicates"
log "Sample: ${SAMPLE}"
log "Input: ${SORTED_BAM}"
log "Output: ${DEDUP_BAM}"
log "Metrics: ${DUP_METRICS}"
log "Temporary directory: ${TMP_DIR}"
log "============================================================"


gatk MarkDuplicates \
    -I "${SORTED_BAM}" \
    -O "${DEDUP_BAM}" \
    -M "${DUP_METRICS}" \
    --TMP_DIR "${TMP_DIR}" \
    --CREATE_INDEX false


log "MarkDuplicates completed successfully."



# CHECK DEDUPLICATED BAM


log "Checking deduplicated BAM..."

if [[ ! -s "${DEDUP_BAM}" ]]; then
    log "ERROR: Deduplicated BAM was not created."
    rm -rf "${TMP_DIR}"
    exit 1
fi

log "Deduplicated BAM created:"
ls -lh "${DEDUP_BAM}" | tee -a "${LOG_FILE}"



# CHECK DUPLICATE METRICS


if [[ ! -s "${DUP_METRICS}" ]]; then
    log "ERROR: Duplicate metrics file was not created."
    rm -rf "${TMP_DIR}"
    exit 1
fi

log "Duplicate metrics created:"
ls -lh "${DUP_METRICS}" | tee -a "${LOG_FILE}"



# CHECK DEDUPLICATED BAM INTEGRITY


log "Loading Samtools..."

module purge
module load app/samtools/1.20

log "Checking deduplicated BAM integrity..."

samtools quickcheck "${DEDUP_BAM}"

log "Deduplicated BAM passed samtools quickcheck."



# REMOVE TEMPORARY DIRECTORY


log "Removing temporary files..."

rm -rf "${TMP_DIR}"

log "Temporary directory removed."



# IMPORTANT:
# INDEXING IS DONE IN A SEPARATE PBS JOB


log "============================================================"
log "MARKDUPLICATES COMPLETED SUCCESSFULLY"
log "Sample: ${SAMPLE}"
log "Deduplicated BAM: ${DEDUP_BAM}"
log "Duplicate metrics: ${DUP_METRICS}"
log "============================================================"
log "IMPORTANT: The deduplicated BAM has NOT been indexed."
log "Run the separate indexing PBS job next."
log "============================================================"
