#!/bin/bash
#PBS -N DV_GLNEXUS
#PBS -l walltime=96:00:00
#PBS -l select=1:ncpus=16:mem=64gb
#PBS -j oe

set -Eeuo pipefail

module purge
module load app/bcftools/1.19

# ============================================================
# DEEPVARIANT JOINT GENOTYPING WITH GLNEXUS
#
# 44 DeepVariant gVCFs
#        ↓
#      GLnexus
#        ↓
# deepvariant_joint.vcf.gz
#        ↓
# deepvariant_joint.vcf.gz.tbi
#
# VQSR is NOT included in this script.
# ============================================================

BASE_DIR="${HOME}/Variantcalling/deepvariant"

GLNEXUS="${BASE_DIR}/software/glnexus/glnexus_cli"

SCRATCH_BASE="/stor6/scratch3/27777197"
COHORT_DIR="${SCRATCH_BASE}/deepvariant_cohort"

GVCF_LIST="${COHORT_DIR}/deepvariant_gvcf_list.txt"

GLNEXUS_DB="${COHORT_DIR}/glnexus_db"

OUTPUT_DIR="${COHORT_DIR}/output"
JOINT_VCF="${OUTPUT_DIR}/deepvariant_joint.vcf.gz"
JOINT_TBI="${JOINT_VCF}.tbi"

GLNEXUS_DONE="${COHORT_DIR}/GLnexus.done"
TMP_DIR="/tmp/${USER}_deepvariant_glnexus_${PBS_JOBID}"

mkdir -p "${COHORT_DIR}"
mkdir -p "${OUTPUT_DIR}"
mkdir -p "${TMP_DIR}"

LOG="${COHORT_DIR}/glnexus_joint.log"

exec > >(tee -a "${LOG}") 2>&1

echo "============================================================"
echo "DEEPVARIANT GLNEXUS JOINT GENOTYPING"
echo "Started: $(date)"
echo "Host: $(hostname)"
echo "PBS Job: ${PBS_JOBID}"
echo "============================================================"


# 44 SAMPLES


SAMPLES=(
    1001
    1003
    1004
    1005
    1007
    1008
    1009
    1010
    1011
    1013
    1014
    1015
    1017
    1018
    1019
    1020
    1021
    1022
    1023
    1024
    1025
    1026
    1027
    1029
    1032
    1033
    1035
    1036
    1037
    1038
    1041
    1042
    1054
    1060
    1064
    1747
    1756
    35
    47
    549
    73
    792
    899
    906
)

echo
echo "Number of samples: ${#SAMPLES[@]}"

if [[ "${#SAMPLES[@]}" -ne 44 ]]; then
    echo "ERROR: Expected 44 samples."
    exit 1
fi


# CHECK GLNEXUS


echo
echo "Checking GLnexus..."

if [[ ! -x "${GLNEXUS}" ]]; then
    echo "ERROR: GLnexus executable not found:"
    echo "${GLNEXUS}"
    exit 1
fi

"${GLNEXUS}" --help | head -25


# CHECK BCFTOOLS


echo
echo "Checking bcftools..."
bcftools --version | head -1


# CREATE GVCF LIST


echo
echo "============================================================"
echo "CHECKING ALL 44 DEEPVARIANT gVCFs"
echo "============================================================"

rm -f "${GVCF_LIST}"

MISSING=0

for SAMPLE in "${SAMPLES[@]}"; do

    GVCF="${BASE_DIR}/${SAMPLE}/deepvariant_output/${SAMPLE}.g.vcf.gz"
    TBI="${GVCF}.tbi"

    if [[ ! -s "${GVCF}" ]]; then
        echo "ERROR: Missing gVCF:"
        echo "${GVCF}"
        MISSING=1
        continue
    fi

    if [[ ! -s "${TBI}" ]]; then
        echo "ERROR: Missing gVCF index:"
        echo "${TBI}"
        MISSING=1
        continue
    fi

    printf "%s\n" "${GVCF}" >> "${GVCF_LIST}"

    echo "COMPLETE: ${SAMPLE}"

done

if [[ "${MISSING}" -ne 0 ]]; then
    echo
    echo "ERROR: One or more DeepVariant gVCFs/indexes are missing."
    exit 1
fi

GVCF_COUNT=$(wc -l < "${GVCF_LIST}")

echo
echo "All DeepVariant gVCFs are present."
echo "gVCFs in list: ${GVCF_COUNT}"

if [[ "${GVCF_COUNT}" -ne 44 ]]; then
    echo "ERROR: Expected 44 gVCFs."
    exit 1
fi


# CHECK WHETHER JOINT CALLING IS ALREADY COMPLETE


echo
echo "============================================================"
echo "CHECKING GLNEXUS COMPLETION"
echo "============================================================"

if [[ -s "${GLNEXUS_DONE}" ]] &&
   [[ -s "${JOINT_VCF}" ]] &&
   [[ -s "${JOINT_TBI}" ]]; then

    echo "GLnexus joint genotyping already completed."
    echo "Skipping."

    exit 0
fi


# REMOVE INCOMPLETE OUTPUT


if [[ -e "${JOINT_VCF}" || -e "${JOINT_TBI}" ]]; then

    echo
    echo "Incomplete joint VCF detected."

    rm -f "${JOINT_VCF}"
    rm -f "${JOINT_TBI}"

    echo "Incomplete joint output removed."

fi


# GLNEXUS DATABASE


if [[ -e "${GLNEXUS_DB}" ]]; then

    echo
    echo "ERROR: GLnexus database directory already exists:"
    echo "${GLNEXUS_DB}"
    echo
    echo "The database will NOT be deleted automatically."
    echo "Inspect it before rerunning."
    exit 1

fi


# RUN GLNEXUS


echo
echo "============================================================"
echo "STEP: GLNEXUS JOINT GENOTYPING"
echo "============================================================"

echo "Started: $(date)"
echo
echo "Configuration: DeepVariantWGS"
echo "gVCF list: ${GVCF_LIST}"
echo "GLnexus database: ${GLNEXUS_DB}"
echo "Joint VCF: ${JOINT_VCF}"

echo
echo "Starting GLnexus..."

"${GLNEXUS}" \
    --config DeepVariantWGS \
    --dir "${GLNEXUS_DB}" \
    --list "${GVCF_LIST}" \
    --threads 16 \
    --mem-gbytes 56 \
    | bcftools view \
        -Oz \
        -o "${JOINT_VCF}" -

echo
echo "GLnexus completed."
echo "Finished: $(date)"


# INDEX JOINT VCF


echo
echo "Indexing joint VCF..."

bcftools index \
    -t \
    "${JOINT_VCF}"


# VERIFY OUTPUT


echo
echo "============================================================"
echo "VERIFYING JOINT VCF"
echo "============================================================"

if [[ ! -s "${JOINT_VCF}" ]]; then
    echo "ERROR: Joint VCF is missing or empty."
    exit 1
fi

if [[ ! -s "${JOINT_TBI}" ]]; then
    echo "ERROR: Joint VCF index is missing."
    exit 1
fi

echo "Joint VCF:"
ls -lh "${JOINT_VCF}"

echo
echo "Joint VCF index:"
ls -lh "${JOINT_TBI}"


# CHECK SAMPLE COUNT


echo
echo "Checking samples in joint VCF..."

JOINT_SAMPLE_COUNT=$(
    bcftools query -l "${JOINT_VCF}" | wc -l
)

echo "Samples in joint VCF: ${JOINT_SAMPLE_COUNT}"

if [[ "${JOINT_SAMPLE_COUNT}" -ne 44 ]]; then
    echo "ERROR: Joint VCF does not contain exactly 44 samples."
    exit 1
fi


# CHECK VCF HEADER


echo
echo "Checking VCF header..."

bcftools view -h "${JOINT_VCF}" | head -20


# CREATE COMPLETION MARKER


{
    echo "Status: GLnexus joint genotyping completed successfully"
    echo "Date: $(date)"
    echo "Host: $(hostname)"
    echo "PBS Job: ${PBS_JOBID}"
    echo "Samples: ${JOINT_SAMPLE_COUNT}"
    echo "Configuration: DeepVariantWGS"
    echo "Joint VCF: ${JOINT_VCF}"
} > "${GLNEXUS_DONE}"


# FINAL SUMMARY


echo
echo "============================================================"
echo "DEEPVARIANT JOINT GENOTYPING COMPLETED"
echo "============================================================"

echo
echo "Joint VCF:"
echo "${JOINT_VCF}"

echo
echo "Joint VCF index:"
echo "${JOINT_TBI}"

echo
echo "Completion marker:"
echo "${GLNEXUS_DONE}"

echo
echo "Finished: $(date)"

echo
echo "VQSR will be performed in a SEPARATE script."
echo "============================================================"
