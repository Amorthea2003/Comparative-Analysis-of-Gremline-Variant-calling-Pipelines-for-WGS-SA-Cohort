#!/bin/bash
#PBS -N persample
#PBS -J 1-3
#PBS -l select=1:ncpus=4:mem=48gb
#PBS -l walltime=12:00:00
#PBS -j oe
set -euo pipefail
module load app/bcftools/1.19
SCR=/stor6/scratch3/27777197/rare
REF=$HOME/Variantcalling/reference/hg38.fa
CALLERS=(gatk dv dragen)
VCFS=(/stor6/scratch3/27777197/gatk_cohort/filtering/gatk_hardfiltered_PASS.vcf.gz $SCR/dv_PASS.vcf.gz /stor6/scratch3/27777197/dragen_gatk_cohort/filtering/dragen_gatk_hardfiltered_PASS.vcf.gz)
c=${CALLERS[$((PBS_ARRAY_INDEX-1))]}; V=${VCFS[$((PBS_ARRAY_INDEX-1))]}
bcftools query -l $V > $SCR/order_$c.txt
bcftools norm -m -any -f $REF $V -Ou \
 | bcftools query -f '%CHROM\t%POS\t%REF\t%ALT\t%TYPE[\t%GT]\n' \
 | awk -F'\t' -v OFS='\t' -v cal=$c -f $HOME/Variantcalling/persample_classify.awk $SCR/order_$c.txt $SCR/gn_chr*.tsv - \
 > $SCR/persample_$c.tsv
echo "done $c"
