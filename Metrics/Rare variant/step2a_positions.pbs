#!/bin/bash
#PBS -N pos_lists
#PBS -l select=1:ncpus=2:mem=16gb
#PBS -l walltime=04:00:00
#PBS -j oe
set -euo pipefail
SCR=/stor6/scratch3/27777197/rare
for c in gatk dv dragen; do zcat $SCR/${c}_alleles.tsv.gz | cut -f1,2; done \
 | LC_ALL=C sort -u -S 8G -T $SCR -k1,1 -k2,2n > $SCR/pos_all.tsv
awk -v d=$SCR '$1 ~ /^chr([1-9]|1[0-9]|2[0-2]|X)$/ {print > d"/pos_"$1".tsv"}' $SCR/pos_all.tsv
wc -l $SCR/pos_chr*.tsv
echo done
