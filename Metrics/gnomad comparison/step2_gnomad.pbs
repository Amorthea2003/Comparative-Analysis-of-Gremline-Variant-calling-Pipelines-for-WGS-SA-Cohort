#!/bin/bash
#PBS -N gnomad_extract
#PBS -J 1-23
#PBS -l select=1:ncpus=2:mem=16gb
#PBS -l walltime=08:00:00
#PBS -j oe
set -euo pipefail
module load app/bcftools/1.19
SCR=/stor6/scratch3/27777197/rare
REF=$HOME/Variantcalling/reference/hg38.fa
CHRS=(chr1 chr2 chr3 chr4 chr5 chr6 chr7 chr8 chr9 chr10 chr11 chr12 chr13 chr14 chr15 chr16 chr17 chr18 chr19 chr20 chr21 chr22 chrX)
chr=${CHRS[$((PBS_ARRAY_INDEX-1))]}
GN=https://storage.googleapis.com/gcp-public-data--gnomad/release/4.1/vcf/genomes/gnomad.genomes.v4.1.sites.${chr}.vcf.bgz
echo "start $chr $(date)"
bcftools view -T $SCR/pos_$chr.tsv $GN -Ou \
| bcftools norm -m -any -f $REF -Ou \
| bcftools query -f '%CHROM\t%POS\t%REF\t%ALT\t%FILTER\t%INFO/AF_grpmax\n' > $SCR/gn_$chr.tsv
echo "end $chr $(date)"
